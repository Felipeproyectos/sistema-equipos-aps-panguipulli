{
  "name": "AsignacionChofer",
  "type": "object",
  "description": "Qué chofer tiene a cargo qué vehículo, y desde cuándo. Reemplaza el campo de texto libre `conductor_responsable` de la ficha del equipo, que servía para anotar un nombre pero no para saber nada.",
  "properties": {
    "chofer_id": {
      "type": "string",
      "description": "Id del usuario con rol 'chofer'"
    },
    "chofer_email": {
      "type": "string"
    },
    "chofer_nombre": {
      "type": "string",
      "description": "Se guarda ademas del id para que la pantalla no cruce con usuario en cada fila"
    },
    "equipo_id": {
      "type": "string"
    },
    "equipo_label": {
      "type": "string",
      "description": "Marca, modelo y patente, para mostrar sin cruzar"
    },
    "desde": {
      "type": "string",
      "format": "date",
      "description": "Desde cuando tiene el vehiculo a cargo"
    },
    "hasta": {
      "type": "string",
      "format": "date",
      "description": "Hasta cuando. Vacio = indefinida, es la asignacion vigente."
    },
    "estado": {
      "type": "string",
      "enum": [
        "activa",
        "terminada",
        "cancelada"
      ],
      "default": "activa",
      "description": "Un vehiculo tiene una sola asignacion 'activa' a la vez"
    },
    "turno": {
      "type": "string",
      "enum": [
        "completo",
        "manana",
        "tarde"
      ],
      "default": "completo",
      "description": "El caso principal es 'completo' (el dia entero). Los otros dos dejan partir la jornada entre dos choferes sin que el sistema lo trate como un choque."
    },
    "hora_salida": {
      "type": "string",
      "description": "Descriptivo, no entra en el calculo del choque"
    },
    "hora_regreso": {
      "type": "string",
      "description": "Descriptivo, no entra en el calculo del choque"
    },
    "destino": {
      "type": "string",
      "description": "A donde va. Descriptivo."
    },
    "prestamo_id": {
      "type": "string",
      "description": "Si esta asignacion es por un prestamo, cual. Deja que la bitacora del chofer diga 'durante el prestamo a X' y no solo el vehiculo."
    },
    "observaciones": {
      "type": "string"
    }
  },
  "required": [
    "chofer_id",
    "equipo_id",
    "desde"
  ]
  // Sin bloque "rls" a proposito, igual que `usuario`: las policies de esta
  // tabla estan escritas a mano en migracion/15_asignaciones.sql porque una
  // de ellas llama a licencia_vigente(chofer_id), una regla que este formato
  // no sabe expresar — solo admite condiciones sobre el rol de quien escribe.
}
