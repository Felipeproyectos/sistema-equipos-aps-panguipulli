{
  "name": "Solicitud",
  "type": "object",
  "properties": {
    "equipo_id": {
      "type": "string"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "compra_repuestos",
        "cambio_parches",
        "mantenimiento_preventivo",
        "mantenimiento_correctivo",
        "revision_tecnica",
        "otros"
      ]
    },
    "fecha": {
      "type": "string",
      "format": "date"
    },
    "usuario_email": {
      "type": "string"
    },
    "usuario_nombre": {
      "type": "string"
    },
    "origen": {
      "type": "string",
      "description": "De donde vino. Vacio = Salud desde la ficha del equipo; 'pauta_chofer' = falla marcada por el chofer en la pauta de inicio o al entregar el vehiculo; 'pauta_inspeccion' = falla de una pauta aprobada en Revision Bitacora (la decide Movilizacion si es vehiculo, Salud si es equipo)"
    },
    "centro": {
      "type": "string"
    },
    "estado": {
      "type": "string",
      "enum": [
        "pendiente",
        "derivada",
        "en_proceso",
        "devuelta",
        "finalizada",
        "rechazada"
      ],
      "default": "pendiente",
      "description": "pendiente (el centro la completa) → derivada (en el Monitor Corporativo) → en_proceso (el Monitor la tomó) → finalizada | rechazada; devuelta = el Monitor pide más información. Las de vehículos usan solo pendiente → en_proceso → finalizada (Movilización). Ver migracion/31_solicitudes_monitor.sql"
    },
    "observaciones": {
      "type": "string"
    },
    "alerta_id": {
      "type": "string",
      "description": "Alerta que originó esta solicitud"
    },
    "respuesta_admin": {
      "type": "string"
    },
    "numero_solicitud": {
      "type": "string",
      "description": "Correlativo SOL-AAAA-NNNNN; lo pone la base"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "mantenimiento",
        "compra_insumo",
        "desperfecto_tecnico"
      ]
    },
    "prioridad": {
      "type": "string",
      "enum": [
        "critica",
        "alta",
        "media",
        "baja"
      ]
    },
    "operatividad": {
      "type": "string",
      "enum": [
        "operativo",
        "operativo_con_restricciones",
        "fuera_de_servicio"
      ],
      "description": "En qué estado queda el equipo"
    },
    "descripcion": {
      "type": "string",
      "description": "Descripción detallada del problema o requerimiento"
    },
    "fecha_deteccion": {
      "type": "string",
      "format": "date"
    },
    "equipo_tipo": {
      "type": "string",
      "description": "Copia de la ficha del equipo al enviarla al Monitor"
    },
    "equipo_marca": {
      "type": "string",
      "description": "Copia de la ficha del equipo al enviarla al Monitor"
    },
    "equipo_modelo": {
      "type": "string",
      "description": "Copia de la ficha del equipo al enviarla al Monitor"
    },
    "equipo_numero_serie": {
      "type": "string",
      "description": "Copia de la ficha del equipo al enviarla al Monitor"
    },
    "equipo_numero_inventario": {
      "type": "string",
      "description": "Copia de la ficha del equipo al enviarla al Monitor"
    },
    "subsede": {
      "type": "string"
    },
    "ubicacion_especifica": {
      "type": "string",
      "description": "Ubicación exacta del equipo: sala, box, piso"
    },
    "solicitante_cargo": {
      "type": "string"
    },
    "solicitante_telefono": {
      "type": "string"
    },
    "insumo_nombre": {
      "type": "string"
    },
    "insumo_cantidad": {
      "type": "number"
    },
    "insumo_especificacion": {
      "type": "string",
      "description": "Código, referencia o compatibilidad del insumo"
    },
    "derivada_por_email": {
      "type": "string"
    },
    "derivada_por_nombre": {
      "type": "string"
    },
    "fecha_derivacion": {
      "type": "string",
      "format": "date-time"
    },
    "monitor_email": {
      "type": "string"
    },
    "monitor_nombre": {
      "type": "string"
    },
    "fecha_toma": {
      "type": "string",
      "format": "date-time"
    },
    "fecha_resolucion": {
      "type": "string",
      "format": "date-time"
    },
    "resolucion": {
      "type": "string",
      "description": "Resolución o motivo escrito por el Monitor Corporativo"
    },
    "linea_tiempo": {
      "type": "array",
      "description": "Registro cronológico: envío, toma, devolución, resolución",
      "items": {
        "type": "object",
        "properties": {
          "fecha": {
            "type": "string",
            "format": "date-time"
          },
          "evento": {
            "type": "string"
          },
          "usuario_email": {
            "type": "string"
          },
          "usuario_nombre": {
            "type": "string"
          },
          "notas": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "equipo_id",
    "tipo",
    "fecha"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "encargado_salud"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "encargado_salud"
          }
        },
        {
          "user_condition": {
            "role": "encargado_compras_salud"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "encargado_salud"
          }
        },
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.estado": "pendiente"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.estado": "pendiente"
            }
          ]
        }
      ]
    }
  }
}